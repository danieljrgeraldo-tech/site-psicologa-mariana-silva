---
import BaseLayout from '../layouts/BaseLayout.astro';
import Preloader from '../components/Preloader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import EmpathySection from '../components/EmpathySection.astro';
import SpecialtiesSection from '../components/SpecialtiesSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ApproachSection from '../components/ApproachSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import FaqSection from '../components/FaqSection.astro';
import OnlineBanner from '../components/OnlineBanner.astro';
import InstagramSection from '../components/InstagramSection.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsapp from '../components/FloatingWhatsapp.astro';
---

<BaseLayout>
  <Preloader />
  <Header />
  <main>
    <Hero />
    <EmpathySection />
    <SpecialtiesSection />
    <ProcessSection />
    <ApproachSection />
    <TestimonialsSection />
    <AboutSection />
    <FaqSection />
    <OnlineBanner />
    <InstagramSection />
  </main>
  <Footer />
  <FloatingWhatsapp />
</BaseLayout>
