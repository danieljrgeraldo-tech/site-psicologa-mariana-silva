---
import { siteContent } from '../data/site-content.js';
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-4 glass-panel border-b border-sandBorder/60">
  <!-- Scroll Progress Indicator Bar -->
  <div id="scroll-progress" class="absolute top-0 left-0 h-[3px] bg-gradient-to-r from-emeraldSoft via-goldAccent to-goldLight w-0 transition-all duration-150"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#inicio" class="group flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-emeraldDeep flex items-center justify-center text-goldAccent group-hover:scale-105 transition-transform duration-300 shadow-md">
        <span class="font-serif font-bold text-lg">M</span>
      </div>
      <div class="flex flex-col">
        <span class="font-serif font-bold text-lg leading-tight text-emeraldDeep group-hover:text-goldAccent transition-colors">
          Mariana Silva
        </span>
        <span class="text-[10px] uppercase tracking-widest text-sage-600 font-accent font-medium">
          Psicóloga • {siteContent.professional.crp}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center space-x-8">
      {siteContent.nav.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-sage-700 hover:text-emeraldDeep relative py-1 transition-colors group"
        >
          {item.label}
          <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-goldAccent transition-all duration-300 group-hover:w-full"></span>
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="hidden sm:flex items-center gap-4">
      <a
        href={siteContent.professional.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-shimmer px-5 py-2.5 rounded-full bg-emeraldDeep text-sandLight text-xs font-semibold uppercase tracking-wider hover:bg-emeraldTeal transition-all shadow-luxury hover:shadow-glow-sage flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-goldAccent fill-current" viewBox="0 0 448 512">
          <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
        <span>Agendar Consulta</span>
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-toggle"
      class="lg:hidden p-2 rounded-lg text-emeraldDeep hover:bg-sandWarm transition-colors focus:outline-none"
      aria-label="Abrir Menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-[73px] bg-sandLight/95 backdrop-blur-xl border-b border-sandBorder lg:hidden hidden flex-col p-6 space-y-4 shadow-2xl transition-all duration-300"
  >
    {siteContent.nav.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link text-base font-medium text-sage-800 hover:text-emeraldDeep py-2 border-b border-sandBorder/40 transition-colors"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-4">
      <a
        href={siteContent.professional.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full btn-shimmer py-3 rounded-full bg-emeraldDeep text-sandLight text-center text-sm font-semibold uppercase tracking-wider hover:bg-emeraldTeal transition-all shadow-luxury flex items-center justify-center gap-2"
      >
        <span>Agendar Consulta no WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll progress bar
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('scroll-progress');
      if (bar) bar.style.width = scrolled + '%';
    });

    // Mobile menu toggle
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        menu.classList.toggle('flex');
      });

      links.forEach((link) => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          menu.classList.remove('flex');
        });
      });
    }
  });
</script>
