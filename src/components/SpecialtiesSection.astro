---
import { siteContent } from '../data/site-content.js';
---

<section id="tratamentos" class="py-20 md:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4" data-gsap="fade-up">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sage-100 border border-sage-200 text-emeraldTeal text-xs font-semibold uppercase tracking-wider">
        <span>{siteContent.specialties.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-emeraldDeep leading-tight">
        {siteContent.specialties.title}
      </h2>
      <p class="text-base sm:text-lg text-sage-600">
        {siteContent.specialties.subtitle}
      </p>
    </div>

    <!-- Grid of 6 Specialty Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {siteContent.specialties.items.map((item, index) => (
        <div
          class="glass-card p-8 rounded-3xl relative flex flex-col justify-between group"
          data-gsap="fade-up"
          data-gsap-delay={0.1 * index}
        >
          <div>
            <!-- Icon Container -->
            <div class="w-14 h-14 rounded-2xl bg-emeraldDeep text-goldAccent flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-emeraldTeal transition-all duration-300 shadow-md">
              {item.id === 'ansiedade' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              )}
              {item.id === 'autoestima' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.684a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              )}
              {item.id === 'estresse' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              )}
              {item.id === 'autoconhecimento' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                </svg>
              )}
              {item.id === 'exterior' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 002 2h1.5a2.5 2.5 0 002.5-2.5V11a2 2 0 00-2-2h-1a2 2 0 01-2-2V4.5A2.5 2.5 0 0011.5 2h-1A2.5 2.5 0 008 4.5"/>
                </svg>
              )}
              {item.id === 'procrastinacao' && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              )}
            </div>

            <!-- Specialty Title -->
            <h3 class="text-xl font-serif font-bold text-emeraldDeep mb-3 group-hover:text-goldAccent transition-colors">
              {item.title}
            </h3>

            <!-- Specialty Description -->
            <p class="text-sm text-sage-700 leading-relaxed">
              {item.description}
            </p>
          </div>

          <!-- Bottom Action Link -->
          <div class="mt-6 pt-4 border-t border-sandBorder flex items-center justify-between">
            <a
              href={siteContent.professional.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold text-emeraldDeep hover:text-goldAccent uppercase tracking-wider flex items-center gap-2 group-hover:translate-x-1 transition-transform"
            >
              <span>Agendar para este quadro</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Section CTA -->
    <div class="mt-16 text-center" data-gsap="fade-up">
      <a
        href={siteContent.professional.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-shimmer inline-flex items-center gap-3 px-8 py-4 rounded-full bg-emeraldDeep text-sandLight font-semibold text-sm uppercase tracking-wider hover:bg-emeraldTeal transition-all shadow-luxury"
      >
        <span>Agendar Consulta Pelo WhatsApp</span>
      </a>
    </div>

  </div>
</section>
