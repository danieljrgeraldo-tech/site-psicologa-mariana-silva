---
import { siteContent } from '../data/site-content.js';
---

<section id="sobre-mim" class="py-20 md:py-32 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Portrait Photo & Badges (5 Cols) -->
      <div class="lg:col-span-5 relative" data-gsap="fade-right">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Background Glow Frame -->
          <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-goldAccent/25 via-sage-300/40 to-transparent blur-2xl"></div>

          <!-- Main Portrait Image -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white/90 bg-white group">
            <img
              src="/images/mariana-about.jpg"
              alt="Mariana Silva - Psicóloga"
              class="w-full h-[540px] object-cover object-top group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-emeraldDeep/70 via-transparent to-transparent"></div>

            <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl glass-panel-dark text-sandLight">
              <p class="font-serif font-bold text-xl text-goldLight">Mariana Silva</p>
              <p class="text-xs text-sage-200 uppercase tracking-widest font-accent">{siteContent.professional.crp}</p>
            </div>
          </div>

          <!-- Spain / International Experience Floating Badge -->
          <div class="absolute top-6 -right-6 p-4 rounded-2xl glass-card hidden sm:flex items-center gap-3 shadow-luxury animate-float-slow">
            <div class="w-10 h-10 rounded-xl bg-goldAccent/20 text-goldAccent flex items-center justify-center font-bold text-lg">
              🇪🇸
            </div>
            <div>
              <p class="text-xs font-bold text-emeraldDeep">Experiência Internacional</p>
              <p class="text-[11px] text-sage-600">Univ. Francisco de Vitoria (Madrid)</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Biography & Credentials (7 Cols) -->
      <div class="lg:col-span-7 space-y-6" data-gsap="fade-left">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sage-100 border border-sage-200 text-emeraldTeal text-xs font-semibold uppercase tracking-wider">
          <span>{siteContent.about.badge}</span>
        </div>

        <!-- Title -->
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-emeraldDeep leading-tight">
          {siteContent.about.title}
        </h2>

        <!-- CRP Pill -->
        <div class="inline-block px-4 py-1 rounded-full bg-emeraldDeep text-goldAccent font-serif text-sm font-semibold">
          {siteContent.about.crp}
        </div>

        <!-- Bio Paragraphs -->
        <div class="space-y-4 text-base sm:text-lg text-sage-700 leading-relaxed">
          {siteContent.about.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <!-- Academic & Professional Credentials -->
        <div class="pt-4 border-t border-sandBorder">
          <h3 class="font-serif font-bold text-emeraldDeep text-lg mb-4">Formação & Credenciais:</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {siteContent.about.credentials.map((cred) => (
              <div class="flex items-center gap-3 p-3 rounded-xl bg-sandWarm/80 border border-sandBorder text-xs sm:text-sm font-medium text-sage-800">
                <span class="w-5 h-5 rounded-full bg-emeraldDeep text-goldAccent flex items-center justify-center text-xs shrink-0">✓</span>
                <span>{cred}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <div class="pt-4">
          <a
            href={siteContent.professional.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-shimmer inline-flex items-center gap-3 px-8 py-4 rounded-full bg-emeraldDeep text-sandLight font-semibold text-sm uppercase tracking-wider hover:bg-emeraldTeal transition-all shadow-luxury"
          >
            <span>Conversar Com a Dra. Mariana</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
