---
import { siteContent } from '../data/site-content.js';
---

<section class="py-20 md:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4" data-gsap="fade-up">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sage-100 border border-sage-200 text-emeraldTeal text-xs font-semibold uppercase tracking-wider">
        <span>{siteContent.instagram.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-emeraldDeep">
        {siteContent.instagram.title}
      </h2>
      <a
        href={siteContent.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block text-goldAccent font-semibold hover:underline text-lg"
      >
        {siteContent.instagram.handle}
      </a>
    </div>

    <!-- Instagram Images Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {siteContent.instagram.images.map((item, index) => (
        <a
          href={item.link}
          target="_blank"
          rel="noopener noreferrer"
          class="glass-card rounded-3xl overflow-hidden group block shadow-luxury"
          data-gsap="fade-up"
          data-gsap-delay={0.1 * index}
        >
          <div class="relative overflow-hidden aspect-square">
            <img
              src={item.src}
              alt="Publicação Instagram Mariana Silva"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-emeraldDeep/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <span class="px-5 py-2.5 rounded-full bg-white/90 text-emeraldDeep text-xs font-bold uppercase tracking-wider shadow-lg">
                Ver no Instagram ↗
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- CTA Button -->
    <div class="mt-12 text-center" data-gsap="fade-up">
      <a
        href={siteContent.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-emeraldDeep text-sandLight font-semibold text-sm uppercase tracking-wider hover:bg-emeraldTeal transition-all shadow-luxury"
      >
        <svg class="w-5 h-5 fill-current text-goldAccent" viewBox="0 0 448 512">
          <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/>
        </svg>
        <span>Seguir no Instagram</span>
      </a>
    </div>

  </div>
</section>
