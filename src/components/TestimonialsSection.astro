---
import { siteContent } from '../data/site-content.js';
---

<section id="depoimentos" class="py-20 md:py-32 bg-sandWarm/40 relative overflow-hidden border-y border-sandBorder">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4" data-gsap="fade-up">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-goldAccent/10 border border-goldAccent/30 text-goldAccent text-xs font-semibold uppercase tracking-wider">
        <span>{siteContent.testimonials.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-emeraldDeep leading-tight">
        {siteContent.testimonials.title}
      </h2>
      <p class="text-base sm:text-lg text-sage-600">
        {siteContent.testimonials.subtitle}
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {siteContent.testimonials.items.map((item, index) => (
        <div
          class="glass-card p-8 sm:p-10 rounded-3xl relative flex flex-col justify-between group hover:border-goldAccent/60 transition-all duration-300 shadow-luxury"
          data-gsap="fade-up"
          data-gsap-delay={0.1 * index}
        >
          <div class="space-y-4">
            <!-- 5 Gold Stars Rating -->
            <div class="flex items-center gap-1 text-goldAccent">
              {[...Array(item.rating)].map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <!-- Quote Text -->
            <p class="text-base sm:text-lg text-sage-800 leading-relaxed italic font-serif">
              "{item.text}"
            </p>
          </div>

          <!-- Patient Initials / Author -->
          <div class="mt-8 pt-4 border-t border-sandBorder flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-emeraldDeep text-goldAccent font-serif font-bold text-sm flex items-center justify-center">
                {item.author.charAt(0)}
              </div>
              <div>
                <p class="font-serif font-bold text-emeraldDeep text-base">{item.author}</p>
                <p class="text-xs text-sage-500 font-accent uppercase tracking-wider">Paciente Acompanhado(a)</p>
              </div>
            </div>
            <span class="text-xs text-goldAccent font-semibold">Avaliação Verificada ★</span>
          </div>

        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-16 text-center" data-gsap="fade-up">
      <a
        href={siteContent.professional.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-shimmer inline-flex items-center gap-3 px-8 py-4 rounded-full bg-emeraldDeep text-sandLight font-semibold text-sm uppercase tracking-wider hover:bg-emeraldTeal transition-all shadow-luxury"
      >
        <span>Começar Meu Acompanhamento</span>
      </a>
    </div>

  </div>
</section>
