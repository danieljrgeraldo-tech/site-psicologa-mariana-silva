---
import { siteContent } from '../data/site-content.js';
---

<footer class="bg-emeraldDeep text-sandLight pt-16 pb-12 border-t border-sage-800 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b border-sage-800">
      
      <!-- Column 1: Brand & CRP (5 Cols) -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-goldAccent text-emeraldDeep flex items-center justify-center font-serif font-bold text-lg">
            M
          </div>
          <div>
            <p class="font-serif font-bold text-xl text-sandLight">Dra. Mariana Silva</p>
            <p class="text-xs text-goldAccent uppercase tracking-widest font-accent">{siteContent.professional.crp}</p>
          </div>
        </div>

        <p class="text-sm text-sage-200 leading-relaxed max-w-sm">
          Atendimento psicológico clínico pautado pela ética, empatia e pelos princípios científicos da Terapia Cognitivo-Comportamental (TCC).
        </p>

        <div class="flex items-center gap-4 pt-2">
          <a
            href={siteContent.professional.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-sage-800 hover:bg-goldAccent hover:text-emeraldDeep text-goldAccent flex items-center justify-center transition-colors"
            aria-label="WhatsApp"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 448 512">
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
            </svg>
          </a>
          <a
            href={siteContent.professional.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-sage-800 hover:bg-goldAccent hover:text-emeraldDeep text-goldAccent flex items-center justify-center transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 448 512">
              <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation Links (3 Cols) -->
      <div class="md:col-span-3 space-y-3">
        <p class="font-serif font-bold text-lg text-goldLight">Navegação</p>
        <ul class="space-y-2 text-xs font-medium text-sage-200">
          {siteContent.nav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-goldAccent transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Emergency Crisis Notice (4 Cols) -->
      <div class="md:col-span-4 p-5 rounded-2xl bg-sage-900/60 border border-sage-800 space-y-3">
        <p class="font-serif font-bold text-goldAccent text-sm">Aviso de Emergência & Crise</p>
        <p class="text-xs text-sage-300 leading-relaxed">
          {siteContent.footer.emergencyNotice}
        </p>
        <a
          href="https://cvv.org.br"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-xs font-bold text-goldLight hover:underline"
        >
          Acessar CVV.org.br (Ligue 188) ↗
        </a>
      </div>

    </div>

    <!-- Copyright & Disclaimer -->
    <div class="pt-8 text-center sm:flex sm:items-center sm:justify-between text-xs text-sage-400 space-y-2 sm:space-y-0">
      <p>{siteContent.footer.copy}</p>
      <p class="max-w-md text-left sm:text-right">{siteContent.footer.disclaimer}</p>
    </div>

  </div>
</footer>
